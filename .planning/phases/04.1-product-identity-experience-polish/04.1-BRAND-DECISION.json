	<dict>
		<key>rejectedCandidate</key>
		<string>Modulune; Rove; Quell; Mote; Rill; BitDeck; Bit Deck; Bit-Deck; Bitjuke; BitJuke; bitjuke; Bit Juke; Bit-Juke</string>
		<key>rejectionReason</key>
		<string>The user selected Bitjuke for a full screen on 2026-08-27, but the exact name is already documented as BitJuke/BitTunes, a physical product that let people select songs with mobile phones and pay using Bitcoin wallets. The exact Bitjuke string also identifies Hebei Bitjuke Technology Co., Ltd. as a software-patent assignee. These direct music-device and software-name signals are enough to reject the name as a preliminary proposal without making any legal conclusion.</string>
		<key>state</key>
		<string>rescreen-required</string>
	</dict>
	<key>attorneyReviewRequired</key>
	<true/>
	<key>candidateBrief</key>
	<dict>
		<key>excludedTermsAndImagery</key>
